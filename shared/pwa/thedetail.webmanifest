{
  "name": "KTS 설명서 제작기",
  "short_name": "설명서",
  "lang": "ko",
  "id": "/shared/pwa/thedetail.webmanifest",
  "start_url": "/thedetail/",
  "scope": "/thedetail/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A1128",
  "theme_color": "#0A1128",
  "icons": [
    {
      "src": "/shared/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
