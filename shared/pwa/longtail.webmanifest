{
  "name": "롱테일 키워드 생성기",
  "short_name": "롱테일",
  "lang": "ko",
  "id": "/shared/pwa/longtail.webmanifest",
  "start_url": "/longtail.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A1128",
  "theme_color": "#0A1128",
  "icons": [
    {
      "src": "/shared/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
