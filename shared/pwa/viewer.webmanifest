{
  "name": "더뷰 — KTS 만능 뷰어",
  "short_name": "더뷰",
  "lang": "ko",
  "id": "/shared/pwa/viewer.webmanifest",
  "start_url": "/viewer.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A1128",
  "theme_color": "#0A1128",
  "icons": [
    {
      "src": "/shared/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
